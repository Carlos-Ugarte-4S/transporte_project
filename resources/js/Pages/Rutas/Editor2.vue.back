// Inicialización del mapa
onMounted(() => {
    map = L.map("map").setView([-20.0275, -63.526], 14);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors",
    }).addTo(map);

    map.on("click", (e) => {
        if (modoGuia.value) {
            agregarPuntoGuia(e);

            return;
        }

        if (modoEditar.value) {
            seleccionarSegmentoMapa(e);

            return;
        }
        //cambio para permitir dibujar la ruta manualmente, si el modo de dibujo manual está activo, se agregará un punto a la geometría manual
        if (modoDibujoManual.value) {
            agregarPuntoGeometriaManual(e);

            return;
        }

        agregarPunto(e);
    });
});
</script>

<template>
    <div class="max-w-7xl mx-auto p-6">
        <!-- ================= HEADER ================= -->
        <div
            class="sticky top-0 z-50 bg-white rounded-xl shadow-md border mb-6 px-6 py-4"
        >
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800">
                        Editor de Rutas
                    </h1>

                    <p class="text-gray-500 mt-1">
                        Seleccione las paradas, calcule la ruta y guárdela.
                    </p>
                </div>

                <!-- Barra de herramientas -->
                <div class="flex items-center gap-3">
                    <button
                        @click="reemplazarTramo"
                        class="px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-semibold shadow"
                    >
                        🔄 Aplicar cambio
                    </button>
                    <!-- Editar -->

                    <!-- OSRM -->
                    <button
                        @click="calcularRutaOSRM"
                        class="px-5 py-2.5 rounded-lg bg-green-600 hover:bg-green-700 text-white font-semibold shadow transition-all duration-200"
                    >
                        🛣️ Calcular OSRM
                    </button>

                    <!-- Guardar -->
                    <button
                        @click="guardarRuta"
                        class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow transition-all duration-200"
                    >
                        💾 Guardar Ruta
                    </button>

                    <button
                        @click="probarHibrida"
                        class="bg-purple-600 text-white px-3 py-2 rounded"
                    >
                        Probar híbrida
                    </button>

                    <button
                        @click="mostrarPuntosEdicion"
                        class="bg-blue-500 text-white px-3 py-2 rounded"
                    >
                        Editar segmento
                    </button>

                    <button
                        @click="guardarSegmento"
                        class="bg-green-600 text-white px-3 py-2 rounded"
                    >
                        Guardar segmento
                    </button>

                    <button
                        @click="modoDibujoManual = !modoDibujoManual"
                        class="bg-green-600 text-white px-3 py-2 rounded"
                    >
                        ✏️ Dibujar ruta manual
                    </button>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <label class="font-semibold"> Tipo de ruta </label>

            <select v-model="tipoRuta" class="border rounded p-3">
                <option value="osrm">OSRM</option>

                <option value="manual">Manual</option>

                <option value="hibrida">Híbrida</option>
            </select>
        </div>

        <!-- ================= DATOS ================= -->

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div>
                <label class="block mb-2 font-semibold">
                    Nombre de la Ruta
                </label>

                <input
                    v-model="nombreruta"
                    type="text"
                    placeholder="Ej. Ruta Centro"
                    class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-blue-400 outline-none"
                />
            </div>

            <div>
                <label class="block mb-2 font-semibold"> Línea </label>

                <select
                    v-model="idlinea"
                    class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-blue-400 outline-none"
                >
                    <option value="">Seleccione una línea</option>

                    <option
                        v-for="linea in lineas"
                        :key="linea.idlinea"
                        :value="linea.idlinea"
                    >
                        {{ linea.nombre }}
                        -
                        {{ linea.sindicato.nombre }}
                    </option>
                </select>
            </div>

            <div>
                <label class="block mb-2 font-semibold"> Origen </label>

                <input
                    v-model="origen"
                    type="text"
                    placeholder="Terminal"
                    class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-blue-400 outline-none"
                />
            </div>

            <div>
                <label class="block mb-2 font-semibold"> Destino </label>

                <input
                    v-model="destino"
                    type="text"
                    placeholder="Mercado Central"
                    class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-blue-400 outline-none"
                />
            </div>
        </div>

        <!-- ================= MAPA ================= -->

        <div class="bg-white rounded-xl shadow-md border p-4">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-xl font-bold">🗺️ Mapa</h2>

                <span
                    class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-sm font-semibold"
                >
                    {{ puntos.length }} Paradas
                </span>
            </div>

            <div id="map" class="rounded-lg border" style="height: 600px"></div>
        </div>

        <!-- ================= PARADAS ================= -->

        <div class="mt-8">
            <h2 class="text-xl font-bold mb-4">📍 Paradas Seleccionadas</h2>

            <div v-if="puntos.length === 0" class="text-gray-500 italic">
                Aún no existen paradas seleccionadas.
            </div>

            <div
                v-for="(punto, index) in puntos"
                :key="index"
                class="bg-white rounded-xl border shadow-sm p-4 mb-3 flex justify-between items-center hover:shadow-md transition"
            >
                <div>
                    <div class="font-bold text-lg">Parada {{ index + 1 }}</div>

                    <div class="text-gray-600 mt-1">
                        Lat:
                        {{ punto.lat.toFixed(6) }}

                        <br />

                        Lng:
                        {{ punto.lng.toFixed(6) }}
                    </div>
                </div>

                <div class="flex gap-2">
                    <button
                        @click="subirPunto(index)"
                        class="w-10 h-10 rounded-lg bg-gray-200 hover:bg-gray-300"
                    >
                        ⬆️
                    </button>

                    <button
                        @click="bajarPunto(index)"
                        class="w-10 h-10 rounded-lg bg-gray-200 hover:bg-gray-300"
                    >
                        ⬇️
                    </button>

                    <button
                        @click="eliminarPuntoLista(index)"
                        class="w-10 h-10 rounded-lg bg-red-500 hover:bg-red-600 text-white"
                    >
                        🗑️
                    </button>
                </div>
            </div>
        </div>
    </div>
</template>
